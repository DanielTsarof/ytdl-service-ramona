# Copy to .env and adjust. Durations use Go syntax: 90s, 30m, 1h, 168h (no "d" unit).

# --- Required ---
DATABASE_URL=postgres://ytdl:secret@localhost:5432/ytdl?sslmode=disable

# --- HTTP / Redis ---
HTTP_ADDR=:8080
# Rate limiting and the read cache. If Redis is down both degrade gracefully
# (requests are allowed and served uncached); /readyz reports it.
REDIS_URL=redis://localhost:6379/0

# --- Storage ---
STORAGE_BACKEND=s3            # local | s3
STORAGE_LOCAL_DIR=./data      # used when STORAGE_BACKEND=local
S3_BUCKET=ytdl-media
S3_REGION=us-east-1
S3_ENDPOINT=                  # set for MinIO / R2, e.g. http://localhost:9000
S3_PATH_STYLE=false           # true for most self-hosted S3-compatible stores
S3_PREFIX=
# Credentials come from the standard AWS chain:
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# --- Media ---
WORK_DIR=                     # scratch space for downloads; default <tmp>/ytdl-service
MAX_DURATION_SECONDS=10800    # reject longer sources (0 = no limit)
YTDLP_COOKIES=                # optional Netscape cookies.txt for yt-dlp

# --- Retention and async tasks ---
FILE_IDLE_TTL=168h            # delete stored files not requested for this long ("Time N")
CLEANUP_INTERVAL=1h           # how often the cleanup runs
TASK_RESULT_TTL=1h            # a finished task's file is downloadable by task ID this long
TASK_WORKERS=4
TASK_LEASE=2m                 # a task whose worker stops heartbeating this long is retried

# --- Webhooks ---
WEBHOOK_TIMEOUT=60s
WEBHOOK_MAX_ATTEMPTS=6        # retries back off 30s, 2m, 10m, 30m, 1h, 1h...
WEBHOOK_ALLOW_PRIVATE=false   # true disables the SSRF guard (local development only)

# --- Limits / cache ---
RATE_LIMIT_PER_MINUTE=60      # per API key
RATE_LIMIT_BURST=20
CACHE_TTL=30s                 # max staleness of cached reads

# --- First administrator ---
# Created on startup if no user has this email. Leave BOOTSTRAP_ADMIN_API_KEY
# empty to have a key generated and logged once (WARN level); or set your own
# (must start with "ytdl_" and be at least 40 characters) so nothing secret
# is logged.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_API_KEY=

# --- Logging ---
LOG_LEVEL=info                # debug | info | warn | error
LOG_FORMAT=text               # text | json
